{
  "$schema": "https://schema.railpack.com",
  "provider": "dotnet",
  "build": {
    "buildCommand": "dotnet restore && dotnet publish -c Release -o out"
  },
  "deploy": {
    "startCommand": "dotnet out/InstructionPlatform.Api.dll",
    "port": 7150,
    "variables": {
      "ASPNETCORE_ENVIRONMENT": "Production",
      "ASPNETCORE_URLS": "https://0.0.0.0:${PORT:-7150}"
    }
  }
}