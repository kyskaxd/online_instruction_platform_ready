{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build-frontend": {
      "inputs": ["."],
      "commands": [
        "cd frontend/instruction-platform-client",
        "npm install",
        "npm run build"
      ],
      "deployOutputs": ["frontend/instruction-platform-client/dist"]
    },
    "build-backend": {
      "inputs": ["."],
      "commands": [
        "cd backend/InstructionPlatform.Api",
        "dotnet restore",
        "dotnet publish -c Release -o out"
      ],
      "deployOutputs": ["backend/InstructionPlatform.Api/out"]
    }
  },
  "deploy": {
    "startCommand": "cd backend/InstructionPlatform.Api && dotnet run --launch-profile https & npx serve -s frontend/instruction-platform-client/dist -l 5173",
    "port": 7150,
    "variables": {
      "ASPNETCORE_URLS": "https://0.0.0.0:${PORT:-7150}"
    }
  }
}